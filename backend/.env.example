# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit real credentials.
# Run the server from inside the `backend/` folder so this file is found.

# --- PostgreSQL / Neon connection ---
# Get this from your Neon project dashboard → Connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require

# Comma-separated list of frontend origins allowed to call this API.
# Add your deployed Netlify URL here for production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to false to skip inserting the demo events on first run.
SEED_DEMO_DATA=true

# --- JWT Auth ---
JWT_SECRET_KEY=changeme-use-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
