# Copy this file to `.env` and adjust if your backend runs elsewhere.
# `.env` is gitignored - never commit real values.
#
# Vite only exposes variables prefixed with VITE_ to the browser, and it
# inlines them at build time. Restart `npm run dev` after changing this file.

# Local development
VITE_API_BASE_URL=http://localhost:8000

# Production (Render backend) — set this in Netlify dashboard under
# Site Settings → Environment Variables, NOT in a committed .env file.
# VITE_API_BASE_URL=https://event-management-api.onrender.com
